# UI host port; the container continues to listen on 8080.
UI_PORT=8088
# All inference is local. No hosted model API keys are used.
LLM_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
# Local inference accounting only; independent of your ChatGPT subscription.
# A request reserves 8960 tokens; usage settles to Ollama reported tokens.
LLM_DAILY_TOKEN_BUDGET=50000
# Enable only for the live profile; synthetic and live data must use separate volumes.
COLLECTOR_ENABLED=false
USER_AGENT=NewEdenIntel/0.1 (replace-with-your-project-url-or-contact)
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional comma-separated system IDs; scopes analytics before the 50,000-record cap.
# Example: 30000142,30000144. Leave empty to analyze all collected systems.
ANALYSIS_SYSTEM_IDS=
# Optional ESI system NPC-count snapshots; independent of zKill ingestion.
NPC_COLLECTOR_ENABLED=false
# Comma-separated system IDs. Absent source rows remain unknown, never zero.
NPC_SYSTEM_IDS=

# Background public ESI name lookups; requires USER_AGENT with contact.
NAME_RESOLVER_ENABLED=true
# Background public ESI geography cache; requires the contact-bearing USER_AGENT above.
# Cached geography is read locally during questions; set false to disable background refreshes.
GEOGRAPHY_RESOLVER_ENABLED=true
